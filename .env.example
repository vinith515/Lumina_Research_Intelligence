# ==============================================================================
# ResearchMind Configuration
# ==============================================================================

# Data Paths
RESEARCHMIND_DATA_DIR=AI_Research_Dataset
RESEARCHMIND_PROCESSED_DIR=data/processed
RESEARCHMIND_METADATA_DIR=data/metadata
RESEARCHMIND_INDEX_DIR=indexes

# Ingestion
RESEARCHMIND_UNSTRUCTURED_STRATEGY=fast
RESEARCHMIND_FALLBACK_STRATEGY=auto
RESEARCHMIND_EXTRACT_TABLES=true

# Chunking
RESEARCHMIND_TARGET_CHUNK_SIZE=1800
RESEARCHMIND_MAX_CHUNK_SIZE=3000
RESEARCHMIND_MIN_CHUNK_SIZE=150
RESEARCHMIND_CHUNK_OVERLAP=200

# Embeddings
RESEARCHMIND_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RESEARCHMIND_DEVICE=cuda
RESEARCHMIND_EMBEDDING_BATCH_SIZE=32
RESEARCHMIND_NORMALIZE_EMBEDDINGS=true

# Retrieval
RESEARCHMIND_DENSE_TOP_K=20
RESEARCHMIND_SPARSE_TOP_K=20
RESEARCHMIND_RRF_K=60
RESEARCHMIND_HYBRID_TOP_K=20

# Reranking
RESEARCHMIND_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RESEARCHMIND_RERANKER_TOP_K=5
RESEARCHMIND_ENABLE_RERANKER=true

# LLM Generation
RESEARCHMIND_LLM_PROVIDER=gemini
RESEARCHMIND_LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# XAI & Explainability
RESEARCHMIND_ENABLE_XAI=true
RESEARCHMIND_MIN_EVIDENCE_SCORE=0.3
